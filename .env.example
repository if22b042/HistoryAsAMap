# Copy to .env for local development (python-dotenv loads it for `flask` commands).
# In production set these in Vercel → Project → Settings → Environment Variables.

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave empty locally to use SQLite at instance/haam.db.
# Production example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Editor login. Create the hash with: flask --app haam haam hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional
# HAAM_ENV=development            # development | production (default: production on Vercel)
# HAAM_USER_AGENT=HistoryAsAMap/2.0 (+https://github.com/if22b042/HistoryAsAMap)
# GEOCODING_ENABLED=true          # look up the country of each event via OpenStreetMap
