# Copy to .env for local development (python-dotenv loads it for `flask` commands).
# In production set these in Vercel → Project → Settings → Environment Variables.

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave empty locally to use SQLite at instance/haam.db.
# Production example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Editor login. Create the hash with: flask --app haam haam hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional
# HAAM_ENV=development            # development | production (default: production on Vercel)
# HAAM_USER_AGENT=HistoryAsAMap/2.0 (+https://github.com/if22b042/HistoryAsAMap)
# GEOCODING_ENABLED=true          # look up the country of each event via OpenStreetMap

# Optional: email the share and edit links once when a collection is created.
# Without SMTP_HOST the email field on "New collection" is hidden.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                   # 465 = SSL, anything else = STARTTLS
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=History As A Map <noreply@example.com>
# MAIL_PER_RECIPIENT_HOURLY=2     # mails to one address per hour
# MAIL_PER_CLIENT_HOURLY=3        # mails per visitor per hour
# MAIL_DAILY_LIMIT=200            # mails in total per day
# TRUSTED_PROXIES=0               # proxies in front of the app that append to X-Forwarded-For (Vercel: 1, set automatically)
